{
    "name": "Autopilot",
    "version": "1.0.0",
    "private": true,
    "description": "무인 자율 개발 환경, Autopilot",
    "author": "ReguMaster",
    "main": "desktop/main.cjs",
    "scripts": {
        "start": "electron .",
        "dev": "electron . --dev",
        "test": "electron . --smoke-test",
        "test:desktop": "node tests/checkDesktopRunner.js && node tests/checkDesktopView.js && node tests/checkDesktopAccounts.js",
        "build": "electron-builder --win --x64 --dir",
        "dist": "electron-builder --win --x64",
        "test:cli": "node tests/checkAutopilot.js",
        "format:cli": "prettier --write autopilot/core/autopilot_loop.js tests/checkAutopilot.js \"tests/lib/*.js\" \"autopilot/src/**/*.js\"",
        "format:check:cli": "prettier --check autopilot/core/autopilot_loop.js tests/checkAutopilot.js \"tests/lib/*.js\" \"autopilot/src/**/*.js\"",
        "format:desktop": "prettier --write desktop/main.cjs desktop/preload.cjs desktop/autopilotRunner.cjs desktop/autopilotIpc.cjs desktop/projectFiles.cjs desktop/claudeAccount.cjs desktop/claudeCli.cjs desktop/accountStore.cjs desktop/accountIpc.cjs desktop/viewFormat.js desktop/sky.js desktop/renderer.js desktop/index.html desktop/styles.css tests/checkDesktopRunner.js tests/checkDesktopView.js tests/checkDesktopAccounts.js",
        "format:check:desktop": "prettier --check desktop/main.cjs desktop/preload.cjs desktop/autopilotRunner.cjs desktop/autopilotIpc.cjs desktop/projectFiles.cjs desktop/claudeAccount.cjs desktop/claudeCli.cjs desktop/accountStore.cjs desktop/accountIpc.cjs desktop/viewFormat.js desktop/sky.js desktop/renderer.js desktop/index.html desktop/styles.css tests/checkDesktopRunner.js tests/checkDesktopView.js tests/checkDesktopAccounts.js"
    },
    "devDependencies": {
        "electron": "^44.6.0",
        "electron-builder": "26.15.3",
        "prettier": "^3.9.6"
    },
    "build": {
        "appId": "com.autopilot.desktop",
        "productName": "AutoPilot",
        "directories": {
            "output": "dist"
        },
        "files": [
            "desktop/**/*",
            "docs/logo.png",
            "docs/icon.png",
            "package.json"
        ],
        "win": {
            "target": [
                "portable",
                "nsis"
            ],
            "icon": "docs/icon.png",
            "signAndEditExecutable": true,
            "signtoolOptions": {
                "certificateSubjectName": "ReguMaster",
                "publisherName": "ReguMaster"
            }
        },
        "electronLanguages": [
            "ko",
            "en-US"
        ],
        "compression": "maximum",
        "portable": {
            "artifactName": "AutoPilot-Portable-${version}-${arch}.${ext}"
        },
        "nsis": {
            "artifactName": "AutoPilot-Setup-${version}-${arch}.${ext}",
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "allowElevation": true,
            "language": "1042",
            "installerSidebar": "build/installer/installerSidebar.bmp",
            "uninstallerSidebar": "build/installer/uninstallerSidebar.bmp",
            "installerHeader": "build/installer/installerHeader.bmp"
        },
        "extraResources": [
            {
                "from": "autopilot",
                "to": "engine",
                "filter": [
                    "core/**/*",
                    "src/**/*",
                    "package.json"
                ]
            }
        ]
    },
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    }
}
